{
    "profile": "jinja",
    "indent": 4,
    "max_line_length": 120,
    "format_attribute_template_tags": true,
    "format_css": true,
    "format_js": true,
    "line_break_after_multiline_tag": true,
    "collapse_whitespace": true,
    "blank_line_after_tag": "load,extends,include,endblock,endfor,endif",
    "blank_line_before_tag": "block",
    "ignore": "H021,H023",
    "quote_style": "single"
}
